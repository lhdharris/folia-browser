{
  "name": "folia-browser",
  "version": "2.1.2",
  "description": "A browser with many limitations that will help you become happier and more virtuous — or at least more attentive to things other than the internet.",
  "main": "main.js",
  "author": {
    "name": "Louis Harris",
    "email": "lhd.louis.harris@gmail.com"
  },
  "homepage": "https://github.com/lhdharris/folia-browser",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:linux": "electron-builder --linux rpm deb",
    "build:mac": "electron-builder --mac dmg",
    "build:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "https://github.com/castlabs/electron-releases#v42.3.3+wvcus",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.github.lhdharris.folia-browser",
    "productName": "Folia Browser",
    "files": [
      "main.js",
      "preload.js",
      "webview-preload.js",
      "updater.js",
      "renderer/**"
    ],
    "protocols": [
      {
        "name": "Web URL",
        "schemes": [
          "http",
          "https"
        ]
      }
    ],
    "electronDownload": {
      "mirror": "https://github.com/castlabs/electron-releases/releases/download/"
    },
    "linux": {
      "target": [
        "rpm",
        "deb"
      ],
      "category": "Network",
      "executableName": "folia-browser",
      "maintainer": "lhd.louis.harris@gmail.com",
      "icon": "build/icons",
      "mimeTypes": [
        "x-scheme-handler/http",
        "x-scheme-handler/https",
        "text/html"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icon.png",
      "identity": null
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
